# Copy to .env and fill in. .env is git-ignored. Shell variables override this file. Restart the app after editing.
# Option A - one key per agent (all three required):
ANTHROPIC_API_KEY_ATC=
ANTHROPIC_API_KEY_PILOT=
ANTHROPIC_API_KEY_GROUND=
# Option B - one shared key for all agents (leave the three above empty):
# ANTHROPIC_API_KEY=

# Optional
# NEGOTIATION_MODEL=claude-opus-5-5
# NEGOTIATION_CALL_TIMEOUT_S=90
# NEGOTIATION_DEADLINE_S=600
# NEGOTIATION_EFFORT=
